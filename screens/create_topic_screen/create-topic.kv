#:import dp kivy.metrics.dp


# ============================================================
#  TELA CREATE TOPIC (nova pergunta no Forum)
# ============================================================
<CreateTopic>

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: app.theme_cls.backgroundColor

        # ===== HEADER =====
        MDBoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: "104dp"
            padding: ["12dp", "24dp", "20dp", "8dp"]
            spacing: "2dp"

            MDBoxLayout:
                size_hint_y: None
                height: "44dp"
                spacing: "4dp"

                MDIconButton:
                    icon: "arrow-left"
                    theme_icon_color: "Custom"
                    icon_color: "white"
                    pos_hint: {"center_y": 0.5}
                    on_release: root.manager.current = "core_name"

                MDLabel:
                    text: "New Question"
                    text_color: "white"
                    font_style: "Headline"
                    role: "small"
                    bold: True
                    halign: "left"
                    valign: "middle"
                    text_size: self.width, self.height

            MDLabel:
                text: "Share your doubt with the community"
                text_color: 0.61, 0.58, 0.72, 1
                font_style: "Body"
                role: "medium"
                halign: "left"
                padding: ["8dp", 0, 0, 0]
                size_hint_y: None
                height: "22dp"
                text_size: self.width, self.height

        # ===== BARRA DE PROGRESSO =====
        # ligue progress_bar.value (0 a 100) ou use root.progress (0.0 a 1.0)
        MDLinearProgressIndicator:
            id: progress_bar
            size_hint_y: None
            height: "4dp"
            value: root.progress * 100
            theme_color: "Custom"
            indicator_color: app.theme_cls.tertiaryColor
            track_color: 0.18, 0.16, 0.27, 1

        # ===== CONTEUDO =====
        ScrollView:
            do_scroll_x: False

            MDBoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: ["20dp", "16dp", "20dp", "16dp"]
                spacing: "28dp"

                # --- Campo Title ---
                MDBoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "8dp"

                    MDLabel:
                        text: "Title"
                        text_color: "white"
                        font_style: "Title"
                        role: "small"
                        bold: True
                        size_hint_y: None
                        height: "24dp"
                        text_size: self.width, self.height

                    MDTextField:
                        id: id_title
                        mode: "filled"
                        max_text_length: 150
                        theme_bg_color: "Custom"
                        fill_color_normal: 0.12, 0.11, 0.18, 1
                        fill_color_focus: 0.15, 0.14, 0.22, 1
                        theme_line_color: "Custom"
                        line_color_normal: 0.23, 0.21, 0.34, 1
                        line_color_focus: app.theme_cls.tertiaryColor

                        MDTextFieldHintText:
                            text: "What's your question?"

                        MDTextFieldHelperText:
                            text: "Be clear and specific"
                            mode: "persistent"

                        MDTextFieldMaxLengthText:

                # --- Campo Description ---
                MDBoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "8dp"

                    MDLabel:
                        text: "Description"
                        text_color: "white"
                        font_style: "Title"
                        role: "small"
                        bold: True
                        size_hint_y: None
                        height: "24dp"
                        text_size: self.width, self.height

                    MDTextField:
                        id: id_text
                        mode: "filled"
                        multiline: True
                        max_height: "180dp"
                        disabled: root.pass_two
                        theme_bg_color: "Custom"
                        fill_color_normal: 0.12, 0.11, 0.18, 1
                        fill_color_focus: 0.15, 0.14, 0.22, 1
                        theme_line_color: "Custom"
                        line_color_normal: 0.23, 0.21, 0.34, 1
                        line_color_focus: app.theme_cls.tertiaryColor

                        MDTextFieldHintText:
                            text: "Describe your question in detail"

                        MDTextFieldHelperText:
                            text: "Add context, code, what you've tried"
                            mode: "persistent"

                # --- Botao Post ---
                MDButton:
                    style: "filled"
                    theme_bg_color: "Custom"
                    md_bg_color: app.theme_cls.tertiaryColor
                    theme_width: "Custom"
                    size_hint_x: 1
                    size_hint_y: None
                    height: "52dp"
                    radius: [14, 14, 14, 14]
                    disabled: root.only_one
                    on_release: root.send_topic()

                    MDButtonIcon:
                        icon: "send"
                        theme_icon_color: "Custom"
                        icon_color: 0.12, 0.11, 0.18, 1

                    MDButtonText:
                        text: "Post question"
                        theme_text_color: "Custom"
                        text_color: 0.12, 0.11, 0.18, 1
                        bold: True
